---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const [github] = site.links;
---
<Base>
<pre class="code"><code><span class="c">// hello world..</span>
<span class="k">const</span> <span class="v">me</span> = {'{'}
  <span class="p">name</span>: <span class="s">"{site.name}"</span>,
  <span class="p">role</span>: <span class="s">"{site.tagline}"</span>,
  <span class="p">github</span>: <a href={github.href}><span class="s">"{github.href}"</span></a>,
  <span class="p">email</span>: <a href={`mailto:${site.email}`}><span class="s">"{site.email}"</span></a>,
{'}'} <span class="k">as const</span>;

<span class="k">export default</span> <span class="v">me</span>;<span class="caret"></span></code></pre>
</Base>

<style is:global>
  .code {
    font: 1rem/1.8 var(--mono);
    margin: 4rem 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .code a { text-decoration: none; }
  .code a:hover span { text-decoration: underline; }
  .code .c { color: var(--muted); }
  .code .k { color: #c678dd; }
  .code .v { color: var(--accent); }
  .code .p { color: #d19a66; }
  .code .s { color: #4d9a5b; }
  .caret { display: inline-block; width: .55ch; height: 1.1em; background: var(--fg); vertical-align: text-bottom; margin-left: 2px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-color-scheme: dark) {
    .code .s { color: #98c379; }
  }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
</style>
