---
import Base from '../layouts/Base.astro';
import Skyline from '../components/Skyline.astro';
import { education, experience, languages, projects, site, skillGroups } from '../data/site';
---

<Base title="Software Engineer & AI" description="Software engineer and AI researcher in Rome. MSc Computer Science & AI at Sapienza." fullBleed>
  <div class="portfolio-shell">
    <main id="main" class="portfolio-main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="availability"><span aria-hidden="true"></span> MSc CS &amp; AI · Sapienza University, Rome</p>
          <div class="headline-wrap">
            <i class="headline-tape" aria-hidden="true"></i>
            <h1 id="hero-title"><span>SOFTWARE</span><span class="outline">ENGINEER</span><span class="role-line"><em>&amp;</em> AI STUDENT</span></h1>
            <b class="crosses" aria-hidden="true">x x x</b>
          </div>
          <p class="intro">I’m <mark>Ermin</mark>, a software engineer. I build full-stack systems and research how language models can help engineers understand large legacy codebases.</p>
          <div class="actions"><a class="work-button" href="#work">SEE MY WORK <span aria-hidden="true">→</span></a><a class="hello-link" href="#contact">or get in touch</a></div>
          <p class="learning"><span aria-hidden="true">✦</span> BUILDING, RESEARCHING &amp; SHIPPING</p>
          <div class="stack" aria-label="Technology stack: Java, Python, React, RAG"><b>~/stack $</b><span>JAVA</span><i></i><span>PYTHON</span><i></i><span>REACT</span><i></i><span>RAG</span></div>
        </div>
        <section class="artwork" aria-label="Scrapbook portrait illustration of Ermin">
          <div class="sparkle decoration" aria-hidden="true">✦</div><div class="pixel-cursor decoration" aria-hidden="true"></div>
          <div class="portrait-card"><i class="portrait-tape" aria-hidden="true"></i><div class="portrait-frame"><span class="model-label"><i aria-hidden="true"></i>model.train()</span><img class="pixel-person" src="/ermin-pixel.png" width="72" height="90" alt="Pixel-art portrait of Ermin Lilaj" /></div><p class="portrait-caption">ERMIN LILAJ <b aria-hidden="true">↗</b></p></div>
          <aside class="sticky-note"><small>MSc thesis</small><strong>RAG FOR LEGACY<br />CODE</strong></aside>
          <aside class="terminal" aria-label="Current focus terminal"><div class="terminal-top"><i></i><i></i><i></i><b>focus.sh</b></div><p>&gt; current_focus</p><strong>rag_on_cobol<span class="terminal-caret">_</span></strong><small>[status: in progress]</small></aside>
          <div class="code-sticker decoration" aria-hidden="true"><b>&lt;<i>/</i>&gt;</b></div><div class="direction decoration" aria-hidden="true">↳</div>
        </section>
      </section>
    </main>
    <section id="about" class="content-section" aria-labelledby="about-title">
      <div class="section-kicker"><span>01/</span> About</div>
      <div class="about-grid">
        <div><h2 id="about-title">CODE WITH<br /><em>CONTEXT.</em></h2><p>I’m a software engineer based in {site.location}. I graduated in Software Engineering at Epoka University and I’m now doing an MSc in Computer Science &amp; AI at Sapienza.</p><p>I’ve worked across frontend, backend and infrastructure with Java, Spring Boot, Python and JavaScript. My thesis at the Camera dei Deputati explores how retrieval-augmented generation, static analysis and local language models can help developers understand large legacy COBOL codebases.</p><p>Outside work: graphic design, video editing, cycling and strength training.</p></div>
        <aside class="about-note"><small>current mode</small><strong>BUILDING SYSTEMS<br />THAT EXPLAIN<br />SYSTEMS.</strong><i aria-hidden="true">✦</i></aside>
      </div>
      <div class="skill-groups">{skillGroups.map((group) => <div class="skill-group"><h3>{group.label}</h3><p>{group.items.map((skill) => <span class="tag">{skill}</span>)}</p></div>)}</div>
      <p class="languages">{languages}</p>
    </section>
    <section id="work" class="content-section work-section" aria-labelledby="work-title">
      <div class="section-kicker"><span>02/</span> Selected work</div>
      <h2 id="work-title">SELECTED<br /><em>WORK.</em></h2>
      <div class="project-grid">{projects.map((project, index) => <article class="project-card"><span>0{index + 1}/</span><h3>{project.title}</h3><p>{project.description}</p><div>{project.tags.map((tag) => <b>{tag}</b>)}</div><i aria-hidden="true">↗</i></article>)}</div>
    </section>
    <section class="content-section experience-section" aria-labelledby="experience-title">
      <div class="section-kicker"><span>03/</span> Experience</div>
      <h2 id="experience-title">THE<br /><em>WORK LOG.</em></h2>
      <div class="timeline">{experience.map((item) => <article><span>{item.period}</span><div><h3>{item.role}</h3><h4>{item.org}</h4>{item.summary && <p>{item.summary}</p>}</div></article>)}</div>
      <div class="education"><h3>Education</h3>{education.map((item) => <p><strong>{item.degree}</strong><span>{item.org} · {item.period}</span></p>)}</div>
    </section>
    <section class="content-section journey-section" aria-labelledby="journey-title">
      <div class="section-kicker"><span>04/</span> Journey</div>
      <h2 id="journey-title">FROM TIRANA<br /><em>TO ROME.</em></h2>
      <div class="journey">
        <figure class="journey-card">
          <Skyline city="tirana" />
          <figcaption><strong>TIRANA, ALBANIA</strong><span>2022 – 2025</span><p>BSc in Software Engineering at Epoka University, and my first IT and software jobs at GlobalNet and Linfa.</p></figcaption>
        </figure>
        <div class="route" aria-hidden="true">
          <svg viewBox="0 0 120 70"><path d="M6 56Q60 -14 112 52" /><path class="head" d="M104 40l12 14-18 2Z" /></svg>
        </div>
        <figure class="journey-card">
          <Skyline city="rome" />
          <figcaption><strong>ROME, ITALY</strong><span>2025 – NOW</span><p>MSc at Sapienza, software engineering at Links, and thesis research at the Camera dei Deputati.</p></figcaption>
        </figure>
      </div>
    </section>
    <section id="contact" class="content-section contact-section" aria-labelledby="contact-title">
      <div class="section-kicker"><span>05/</span> Contact</div>
      <h2 id="contact-title">LET’S BUILD<br /><em>TOGETHER.</em></h2>
      <p>I’m interested in software, backend and applied AI engineering roles in Italy and across Europe. Get in touch about work, research or collaborations.</p>
      <a class="contact-button" href={`mailto:${site.email}`}>GET IN TOUCH <span aria-hidden="true">↗</span></a>
      <div class="social-links">{site.links.map((link) => <a href={link.href}>{link.label} ↗</a>)}</div>
    </section>
  </div>
</Base>

<style>
  :global(body) { background: var(--paper); color: var(--ink); font-family: var(--font); }
  .portfolio-shell { min-height: 100vh; overflow: hidden; position: relative; background-color: var(--paper); background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 26px 26px; }
  .portfolio-shell::after { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .1; mix-blend-mode: multiply; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E"); z-index: 5; }
  .portfolio-main { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }a:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
  .hero { min-height: calc(100vh - 116px); display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(390px, .92fr); gap: 68px; align-items: center; padding: 58px 0 78px; }.availability { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 24px; padding: 7px 9px; border: 1px solid var(--ink); background: rgba(243,239,223,.84); font: 500 10px var(--mono); letter-spacing: .045em; }.availability span, .model-label i { width: 8px; height: 8px; background: var(--coral); box-shadow: 0 0 0 4px rgba(31,181,168,.15); flex: 0 0 auto; animation: status-pulse 2s ease-in-out infinite; }
  .headline-wrap { position: relative; display: inline-block; }.headline-tape { position: absolute; z-index: -1; right: 1%; top: -11px; width: 88px; height: 27px; background: rgba(169,232,221,.82); transform: rotate(6deg); clip-path: polygon(2% 11%, 100% 0, 97% 90%, 8% 100%); }h1 { margin: 0; font-size: clamp(56px, 6.7vw, 101px); font-weight: 700; line-height: .82; letter-spacing: -.075em; }h1 span { display: block; white-space: nowrap; }h1 .outline { color: var(--paper); -webkit-text-stroke: 2.5px var(--ink); text-shadow: 3px 3px 0 var(--coral); }h1 em { display: inline-block; color: var(--blue); font-family: Georgia, serif; font-size: 1.12em; letter-spacing: -.15em; font-weight: 700; font-style: italic; transform: rotate(-7deg) translateY(2px); margin-right: .08em; }.crosses { position: absolute; color: var(--coral); right: 2%; bottom: -24px; font: 500 14px var(--mono); letter-spacing: .35em; transform: rotate(-7deg); }
  .intro { max-width: 470px; margin: 39px 0 25px; font: 400 14px/1.65 var(--mono); }mark { background: var(--acid); padding: 1px 3px; color: inherit; }.actions { display: flex; align-items: center; gap: 25px; flex-wrap: wrap; }.work-button { background: var(--coral); box-shadow: 5px 5px 0 var(--shadow, var(--ink)); padding: 14px 15px 13px; font-size: 12px; }.work-button span { margin-left: 18px; font-size: 17px; line-height: 0; }.work-button:hover, .work-button:focus-visible { transform: translate(5px,5px); box-shadow: none; }.hello-link { position: relative; color: var(--ink); text-decoration: none; font: 400 11px var(--mono); padding-bottom: 4px; }.learning { margin: 39px 0 14px; color: rgba(14,26,51,.68); font: 500 9px var(--mono); letter-spacing: .13em; }.learning span { color: var(--blue); font-size: 12px; }.stack { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; width: fit-content; max-width: 100%; padding: 8px 10px; border: 1px solid var(--ink); background: rgba(243,239,223,.75); box-shadow: 3px 3px 0 rgba(14,26,51,.4); font: 400 8px var(--mono); letter-spacing: .07em; }.stack b { color: var(--blue); font-weight: 500; }.stack i { width: 4px; height: 4px; background: var(--coral); }
  .artwork { position: relative; width: 100%; height: 520px; min-width: 0; }.portrait-card { position: absolute; z-index: 3; top: 42px; left: 23px; width: 330px; padding: 14px; background: #fbf7e9; border: 2px solid var(--ink); box-shadow: 9px 9px 0 var(--shadow, var(--ink)); transform: rotate(2.5deg); }.portrait-tape { position: absolute; z-index: 4; top: -15px; left: 98px; width: 122px; height: 31px; background: rgba(120,206,230,.72); transform: rotate(-4deg); clip-path: polygon(0 10%, 100% 0, 98% 91%, 5% 100%); }.portrait-frame { height: 355px; position: relative; overflow: hidden; display: flex; align-items: end; justify-content: center; border: 2px solid var(--ink); background-color: var(--blue); background-image: linear-gradient(rgba(255,255,255,.18) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.18) 1px, transparent 1px); background-size: 16px 16px; }.model-label { position: absolute; z-index: 3; top: 10px; left: 9px; display: flex; align-items: center; gap: 5px; padding: 5px 6px; border: 1px solid var(--ink); box-shadow: 2px 2px 0 var(--shadow, var(--ink)); background: var(--paper); font: 400 8px var(--mono); }.model-label i { width: 5px; height: 5px; box-shadow: none; }.pixel-person { display: block; width: 288px; height: 360px; filter: drop-shadow(6px 6px 0 rgba(14,26,51,.58)); image-rendering: pixelated; }.portrait-caption { display: flex; justify-content: space-between; margin: 12px 0 1px; font: 500 12px var(--mono); }.portrait-caption b { color: var(--coral); font-size: 17px; transform: rotate(-15deg); }
  .sticky-note { position: absolute; z-index: 6; right: -1px; bottom: 34px; width: 208px; padding: 14px 13px 16px; border: 2px solid var(--ink); background-color: var(--acid); background-image: linear-gradient(90deg, transparent 89%, rgba(31,75,153,.18) 89%), linear-gradient(transparent 89%, rgba(31,75,153,.18) 89%); background-size: 14px 14px; box-shadow: 5px 5px 0 var(--shadow, var(--ink)); transform: rotate(-5deg); }.sticky-note small { display: block; margin-bottom: 10px; font: 400 9px var(--mono); }.sticky-note strong { font: 700 16px/.98 var(--font); letter-spacing: -.045em; }.terminal { position: absolute; z-index: 5; right: 8px; top: 184px; width: 172px; overflow: hidden; padding: 0 10px 10px; border: 2px solid var(--ink); background: var(--ink); color: var(--paper); box-shadow: 4px 4px 0 var(--coral); transform: rotate(-1deg); font-family: var(--mono); }.terminal-top { height: 25px; display: flex; align-items: center; gap: 4px; margin: 0 -10px 9px; padding: 0 8px; border-bottom: 1px solid #3a4a68; background: #1b2a47; }.terminal-top i { width: 5px; height: 5px; border-radius: 50%; background: var(--coral); }.terminal-top i:nth-child(2) { background: var(--acid); }.terminal-top i:nth-child(3) { background: var(--tape-blue); }.terminal-top b { margin-left: auto; font-size: 8px; font-weight: 400; color: #cfd8e6; }.terminal p, .terminal strong, .terminal small { display: block; margin: 0; }.terminal p { font-size: 8px; }.terminal strong { margin: 5px 0; color: var(--acid); font-size: 10px; font-weight: 500; }.terminal small { color: var(--tape-blue); font-size: 7px; }.terminal-caret { animation: blink 1s steps(1) infinite; }
  .decoration { position: absolute; z-index: 2; }.sparkle { top: 5px; right: 25px; color: var(--ink); font-size: 42px; transform: rotate(15deg); }.pixel-cursor { z-index: 4; left: -3px; top: 193px; width: 51px; height: 68px; background: var(--acid); clip-path: polygon(0 0, 0 100%, 25% 74%, 39% 100%, 54% 91%, 40% 66%, 70% 66%); filter: drop-shadow(4px 4px 0 var(--ink)); }.code-sticker { right: 172px; bottom: 43px; display: grid; place-items: center; width: 87px; height: 56px; border: 2px solid var(--ink); border-radius: 50%; background: var(--coral); box-shadow: 4px 4px 0 var(--shadow, var(--ink)); transform: rotate(10deg); }.code-sticker b { font: 500 22px var(--mono); }.code-sticker i { color: var(--paper); font-style: normal; }.direction { right: 18px; bottom: 3px; color: var(--coral); font: 700 64px/.6 var(--font); transform: rotate(24deg); }
  .content-section { width: min(1180px, calc(100% - 64px)); margin: 0 auto; padding: 88px 0; border-top: 2px solid var(--ink); scroll-margin-top: 28px; }.section-kicker { margin-bottom: 25px; font: 500 10px var(--mono); letter-spacing: .14em; text-transform: uppercase; }.section-kicker span { color: var(--blue); }.content-section h2 { margin: 0; font-size: clamp(48px, 7.2vw, 92px); line-height: .82; letter-spacing: -.08em; }.content-section h2 em { color: var(--blue); font-family: Georgia, serif; font-size: .95em; font-style: italic; letter-spacing: -.11em; }.about-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 74px; align-items: end; }.about-grid p { max-width: 620px; margin: 34px 0 0; font: 400 14px/1.8 var(--mono); }.about-note { position: relative; padding: 22px; border: 2px solid var(--ink); background: var(--acid); box-shadow: 6px 6px 0 var(--shadow, var(--ink)); transform: rotate(2deg); }.about-note small { display: block; margin-bottom: 16px; font: 400 9px var(--mono); text-transform: uppercase; }.about-note strong { display: block; font-size: 22px; line-height: .95; letter-spacing: -.055em; }.about-note i { position: absolute; right: 14px; bottom: 9px; color: var(--coral); font-size: 28px; font-style: normal; }.skill-groups { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-top: 54px; }.skill-group { padding: 15px; border: 2px solid var(--ink); background: rgba(251,247,233,.85); box-shadow: 4px 4px 0 var(--shadow, var(--ink)); }.skill-group:nth-child(2) { transform: rotate(-1deg); }.skill-group:nth-child(4) { transform: rotate(1deg); }.skill-group h3 { margin: 0 0 13px; color: var(--blue); font: 500 10px var(--mono); letter-spacing: .09em; text-transform: uppercase; }.skill-group p { margin: 0; }.languages { margin: 32px 0 0; font: 400 11px var(--mono); color: rgba(14,26,51,.67); }.work-section > h2, .experience-section > h2 { margin-bottom: 42px; }.project-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }.project-card { position: relative; min-height: 300px; padding: 20px; border: 2px solid var(--ink); background: rgba(251,247,233,.94); box-shadow: 6px 6px 0 var(--shadow, var(--ink)); }.project-card:nth-child(2) { background: var(--pink); transform: rotate(1deg); }.project-card:nth-child(3) { background: var(--acid); transform: rotate(-1deg); }.project-card > span { color: var(--blue); font: 500 11px var(--mono); }.project-card h3 { max-width: 230px; margin: 34px 0 12px; font-size: 26px; line-height: .95; letter-spacing: -.06em; }.project-card p { margin: 0 0 27px; font: 400 11px/1.65 var(--mono); }.project-card b { display: inline-block; margin: 0 4px 4px 0; padding: 3px 5px; border: 1px solid var(--ink); background: var(--paper); font: 500 8px var(--mono); }.project-card > i { position: absolute; right: 18px; bottom: 12px; color: var(--coral); font-size: 28px; font-style: normal; }.timeline { border-top: 2px solid var(--ink); }.timeline article { display: grid; grid-template-columns: 180px 1fr; gap: 22px; padding: 25px 0; border-bottom: 2px solid var(--ink); }.timeline article > span { color: var(--blue); font: 500 10px var(--mono); }.timeline h3 { margin: 0; font-size: 22px; letter-spacing: -.04em; }.timeline h4 { margin: 3px 0 11px; color: var(--coral); font: 500 11px var(--mono); }.timeline p { max-width: 720px; margin: 0; font: 400 12px/1.7 var(--mono); }.education { margin-top: 45px; padding: 21px; border: 2px solid var(--ink); background: var(--tape-blue); box-shadow: 5px 5px 0 var(--shadow, var(--ink)); }.education h3 { margin: 0 0 15px; font-size: 20px; }.education p { display: flex; justify-content: space-between; gap: 18px; margin: 7px 0; font-size: 14px; }.education p span { font: 400 10px var(--mono); }.contact-section { padding-bottom: 102px; }.contact-section > p { max-width: 520px; margin: 33px 0 27px; font: 400 14px/1.75 var(--mono); }.contact-button { display: inline-block; padding: 15px 16px; border: 2px solid var(--ink); background: var(--coral); box-shadow: 5px 5px 0 var(--shadow, var(--ink)); color: var(--ink); font: 500 12px var(--mono); text-decoration: none; transition: transform .15s ease, box-shadow .15s ease; }.contact-button:hover, .contact-button:focus-visible { box-shadow: none; transform: translate(5px,5px); }.contact-button span { margin-left: 23px; font-size: 17px; }.social-links { display: flex; gap: 20px; margin-top: 30px; }.social-links a { position: relative; color: var(--blue); font: 500 11px var(--mono); text-decoration: none; }.social-links a::after { position: absolute; right: 0; bottom: -4px; left: 0; height: 2px; background: var(--blue); content: ''; transform: scaleX(0); transform-origin: left; transition: transform .2s ease; }.social-links a:hover::after, .social-links a:focus-visible::after { transform: scaleX(1); }
  @keyframes status-pulse { 50% { opacity: .45; } } @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 960px) { .hero { gap: 32px; }.portrait-card { left: 0; width: 305px; }.portrait-frame { height: 320px; }.pixel-person { transform: scale(.9); transform-origin: bottom; }.terminal { right: 0; }.sticky-note { right: -8px; } }
  @media (max-width: 760px) { .portfolio-main, .content-section { width: min(100% - 36px, 580px); }.hero { display: block; min-height: 0; padding: 42px 0 20px; }.artwork { width: min(100%, 490px); height: 530px; margin: 53px auto 0; }.portrait-card { left: calc(50% - 165px); }.sticky-note { right: 0; }.terminal { right: 0; }.content-section { padding: 66px 0; }.about-grid { grid-template-columns: 1fr; gap: 35px; }.about-note { width: min(300px, 100%); justify-self: end; }.skill-groups, .project-grid { grid-template-columns: 1fr; gap: 20px; }.project-card { min-height: 240px; }.timeline article { grid-template-columns: 1fr; gap: 8px; }.education p { display: block; }.education p span { display: block; margin-top: 4px; }.contact-section { padding-bottom: 78px; } }
  @media (max-width: 420px) { h1 { font-size: clamp(45px, 15.2vw, 62px); } h1 .outline { -webkit-text-stroke-width: 2px; }.intro { font-size: 12px; }.actions { gap: 19px; }.artwork { height: 490px; }.portrait-card { left: calc(50% - 137px); width: 275px; padding: 11px; }.portrait-frame { height: 289px; }.pixel-person { transform: scale(.78); }.portrait-caption { font-size: 10px; }.sticky-note { width: 158px; padding: 10px; bottom: 28px; }.sticky-note strong { font-size: 12px; }.terminal { top: 164px; width: 154px; }.code-sticker { right: 140px; bottom: 18px; transform: scale(.75) rotate(10deg); }.pixel-cursor { left: 0; top: 178px; transform: scale(.8); }.stack { font-size: 7px; gap: 6px; }.direction { right: 5px; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }
  .role-line { font-size: .8em; }
  .portrait-card { animation: card-drop .8s cubic-bezier(.2, .9, .3, 1.15) both; }
  @keyframes card-drop { from { opacity: 0; transform: translateY(-70px) rotate(-4deg); } to { opacity: 1; transform: rotate(2.5deg); } }
  .journey { display: grid; grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr); gap: 8px; align-items: center; margin-top: 46px; }
  .journey-card { margin: 0; padding: 18px 18px 20px; border: 2px solid var(--ink); background: rgba(251,247,233,.94); box-shadow: 6px 6px 0 var(--shadow, var(--ink)); transform: rotate(-1deg); }
  .journey-card:last-child { transform: rotate(1deg); }
  .journey-card figcaption { margin-top: 16px; padding-top: 14px; border-top: 2px dashed var(--ink); }
  .journey-card strong { display: block; font-size: 20px; letter-spacing: -.04em; }
  .journey-card span { display: block; margin: 3px 0 10px; color: var(--blue); font: 500 11px var(--mono); }
  .journey-card p { margin: 0; font: 400 12px/1.65 var(--mono); }
  .route svg { display: block; width: 100%; overflow: visible; }
  .route path { fill: none; stroke: var(--coral); stroke-width: 3; stroke-dasharray: 2 7; stroke-linecap: round; }
  .route .head { fill: var(--coral); stroke: none; }
  @media (max-width: 860px) { .journey { grid-template-columns: 1fr; gap: 14px; } .route { width: 70px; margin: 0 auto; transform: rotate(90deg); } }
</style>
