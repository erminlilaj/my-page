---
import Base from '../layouts/Base.astro';

const pixelRows = [
  '....KKKK....', '...KKKKKK...', '..KKKKKKKK..', '..KSSSSSSK..', '.KSSSEESSSK.',
  '.KSSSSSSSSK.', '.KSSKSSKSSK.', '..KSSSSSSK..', '...KSSSSK...', '....KSSK....',
  '...KKSSKK...', '..RRRRRRRR..', '.RRRRRRRRRR.', '.RRRRRRRRRR.', '.RRRRRRRRRR.',
];
const pixels = pixelRows.flatMap((row) => row.split(''));
---

<Base title="Creative Developer" description="Creative developer and CS + AI student portfolio." hideChrome>
  <div class="portfolio-shell">
    <header class="portfolio-header">
      <div class="header-inner">
        <a class="monogram" href="/" aria-label="Ermin Lilaj, home">EL<span>!</span></a>
        <nav aria-label="Primary navigation">
          <a href="/about"><small>01/</small> About</a>
          <a href="/projects"><small>02/</small> Work</a>
          <a href="mailto:lilajermin04@gmail.com"><small>03/</small> Contact</a>
        </nav>
        <a class="talk-button" href="mailto:lilajermin04@gmail.com">Let’s talk ↗</a>
      </div>
    </header>
    <main class="portfolio-main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="availability"><span aria-hidden="true"></span> CS + AI STUDENT // OPEN TO INTERNSHIPS</p>
          <div class="headline-wrap">
            <i class="headline-tape" aria-hidden="true"></i>
            <h1 id="hero-title"><span>CREATIVE</span><span class="outline">DEVELOPER</span><span><em>&amp;</em> DESIGNER</span></h1>
            <b class="crosses" aria-hidden="true">x x x</b>
          </div>
          <p class="intro">Hey, I’m <mark>Ermin</mark>. I’m exploring the space where intelligent systems, sharp code, and playful design meet.</p>
          <div class="actions"><a class="work-button" href="/projects">SEE MY WORK <span aria-hidden="true">→</span></a><a class="hello-link" href="mailto:lilajermin04@gmail.com">or just say hello</a></div>
          <p class="learning"><span aria-hidden="true">✦</span> LEARNING, BUILDING &amp; BREAKING THINGS</p>
          <div class="stack" aria-label="Technology stack: Python, React, machine learning, TypeScript"><b>~/stack $</b><span>PYTHON</span><i></i><span>REACT</span><i></i><span>ML</span><i></i><span>TYPESCRIPT</span></div>
        </div>
        <section class="artwork" aria-label="Scrapbook portrait illustration of Ermin">
          <div class="flower decoration" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></div><div class="sparkle decoration" aria-hidden="true">✦</div><div class="pixel-cursor decoration" aria-hidden="true"></div>
          <div class="portrait-card"><i class="portrait-tape" aria-hidden="true"></i><div class="portrait-frame"><span class="model-label"><i aria-hidden="true"></i>model.train()</span><div class="pixel-person" aria-hidden="true">{pixels.map((pixel) => <i class={`px px-${pixel}`}></i>)}</div></div><p class="portrait-caption">THAT’S ME! <b aria-hidden="true">↗</b></p></div>
          <aside class="sticky-note"><small>Currently obsessed with</small><strong>NEURAL NETS,<br />WEIRD WEB &amp; COFFEE</strong></aside>
          <aside class="terminal" aria-label="Current focus terminal"><div class="terminal-top"><i></i><i></i><i></i><b>focus.sh</b></div><p>&gt; current_focus</p><strong>machine_learning<span class="terminal-caret">_</span></strong><small>[status: always learning]</small></aside>
          <div class="code-sticker decoration" aria-hidden="true"><b>&lt;<i>/</i>&gt;</b></div><div class="smiley decoration" aria-hidden="true"><i></i><i></i><b></b></div><div class="direction decoration" aria-hidden="true">↳</div>
        </section>
      </section>
    </main>
    <div class="ticker" aria-label="Portfolio focus areas"><div>ARTIFICIAL INTELLIGENCE <i>✦</i> CREATIVE DEVELOPMENT <i>✦</i> COMPUTER SCIENCE <i>✦</i> HUMAN-CENTERED TECH <i>✦</i> BUILDING IN PUBLIC <i>✦</i></div></div>
  </div>
</Base>

<style>
  :global(body) { background: var(--paper); color: var(--ink); font-family: var(--font); }
  .portfolio-shell { min-height: 100vh; overflow: hidden; position: relative; background-color: var(--paper); background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 26px 26px; }
  .portfolio-shell::after { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .1; mix-blend-mode: multiply; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E"); z-index: 5; }
  .header-inner, .portfolio-main { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }.portfolio-header { border-bottom: 2px solid var(--ink); position: relative; z-index: 10; }.header-inner { min-height: 77px; padding: 18px 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .monogram { color: var(--ink); font-size: 25px; font-weight: 700; letter-spacing: -.13em; text-decoration: none; transform: rotate(-3deg); justify-self: start; }.monogram span { color: var(--coral); }nav { display: flex; gap: 42px; }nav a { font: 500 12px var(--mono); color: var(--ink); text-decoration: none; text-transform: uppercase; position: relative; padding: 4px 0; }nav a small { color: var(--blue); font-size: 9px; vertical-align: 1px; }nav a::after, .hello-link::after { content: ''; position: absolute; height: 3px; left: 0; right: 0; bottom: -2px; background: var(--coral); transform: scaleX(0) rotate(-1deg); transform-origin: left; transition: transform .2s ease; }nav a:hover::after, nav a:focus-visible::after, .hello-link:hover::after, .hello-link:focus-visible::after { transform: scaleX(1) rotate(-1deg); }
  .talk-button, .work-button { font: 500 11px var(--mono); text-decoration: none; text-transform: uppercase; border: 2px solid var(--ink); color: var(--ink); transition: transform .15s ease, box-shadow .15s ease; }.talk-button { justify-self: end; background: var(--acid); box-shadow: 3px 3px 0 var(--ink); padding: 10px 12px 9px; }.talk-button:hover, .talk-button:focus-visible { transform: translate(3px, 3px); box-shadow: none; }a:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
  .hero { min-height: calc(100vh - 116px); display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(390px, .92fr); gap: 68px; align-items: center; padding: 58px 0 78px; }.availability { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 24px; padding: 7px 9px; border: 1px solid var(--ink); background: rgba(243,239,223,.84); font: 500 10px var(--mono); letter-spacing: .045em; }.availability span, .model-label i { width: 8px; height: 8px; background: var(--coral); box-shadow: 0 0 0 4px rgba(255,91,71,.15); flex: 0 0 auto; animation: status-pulse 2s ease-in-out infinite; }
  .headline-wrap { position: relative; display: inline-block; }.headline-tape { position: absolute; z-index: -1; right: 1%; top: -11px; width: 88px; height: 27px; background: rgba(215,240,75,.82); transform: rotate(6deg); clip-path: polygon(2% 11%, 100% 0, 97% 90%, 8% 100%); }h1 { margin: 0; font-size: clamp(56px, 6.7vw, 101px); font-weight: 700; line-height: .82; letter-spacing: -.075em; }h1 span { display: block; white-space: nowrap; }h1 .outline { color: var(--paper); -webkit-text-stroke: 2.5px var(--ink); text-shadow: 3px 3px 0 var(--coral); }h1 em { display: inline-block; color: var(--blue); font-family: Georgia, serif; font-size: 1.12em; letter-spacing: -.15em; font-weight: 700; font-style: italic; transform: rotate(-7deg) translateY(2px); margin-right: .08em; }.crosses { position: absolute; color: var(--coral); right: 2%; bottom: -24px; font: 500 14px var(--mono); letter-spacing: .35em; transform: rotate(-7deg); }
  .intro { max-width: 470px; margin: 39px 0 25px; font: 400 14px/1.65 var(--mono); }mark { background: var(--acid); padding: 1px 3px; color: inherit; }.actions { display: flex; align-items: center; gap: 25px; flex-wrap: wrap; }.work-button { background: var(--coral); box-shadow: 5px 5px 0 var(--ink); padding: 14px 15px 13px; font-size: 12px; }.work-button span { margin-left: 18px; font-size: 17px; line-height: 0; }.work-button:hover, .work-button:focus-visible { transform: translate(5px,5px); box-shadow: none; }.hello-link { position: relative; color: var(--ink); text-decoration: none; font: 400 11px var(--mono); padding-bottom: 4px; }.learning { margin: 39px 0 14px; color: rgba(23,23,19,.68); font: 500 9px var(--mono); letter-spacing: .13em; }.learning span { color: var(--blue); font-size: 12px; }.stack { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; width: fit-content; max-width: 100%; padding: 8px 10px; border: 1px solid var(--ink); background: rgba(243,239,223,.75); box-shadow: 3px 3px 0 rgba(23,23,19,.4); font: 400 8px var(--mono); letter-spacing: .07em; }.stack b { color: var(--blue); font-weight: 500; }.stack i { width: 4px; height: 4px; background: var(--coral); }
  .artwork { position: relative; width: 100%; height: 520px; min-width: 0; }.portrait-card { position: absolute; z-index: 3; top: 42px; left: 23px; width: 330px; padding: 14px; background: #fbf7e9; border: 2px solid var(--ink); box-shadow: 9px 9px 0 var(--ink); transform: rotate(2.5deg); }.portrait-tape { position: absolute; z-index: 4; top: -15px; left: 98px; width: 122px; height: 31px; background: rgba(120,206,230,.72); transform: rotate(-4deg); clip-path: polygon(0 10%, 100% 0, 98% 91%, 5% 100%); }.portrait-frame { height: 355px; position: relative; overflow: hidden; display: flex; align-items: end; justify-content: center; border: 2px solid var(--ink); background-color: var(--blue); background-image: linear-gradient(rgba(255,255,255,.18) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.18) 1px, transparent 1px); background-size: 16px 16px; }.model-label { position: absolute; z-index: 3; top: 10px; left: 9px; display: flex; align-items: center; gap: 5px; padding: 5px 6px; border: 1px solid var(--ink); box-shadow: 2px 2px 0 var(--ink); background: var(--paper); font: 400 8px var(--mono); }.model-label i { width: 5px; height: 5px; box-shadow: none; }.pixel-person { display: grid; grid-template-columns: repeat(12, 24px); grid-template-rows: repeat(15, 24px); width: 288px; height: 360px; filter: drop-shadow(6px 6px 0 rgba(23,23,19,.58)); image-rendering: pixelated; }.px { width: 24px; height: 24px; }.px-. { background: transparent; }.px-K { background: var(--ink); }.px-S { background: #d99a72; }.px-E { background: #fff4d7; }.px-R { background: var(--coral); }.portrait-caption { display: flex; justify-content: space-between; margin: 12px 0 1px; font: 500 12px var(--mono); }.portrait-caption b { color: var(--coral); font-size: 17px; transform: rotate(-15deg); }
  .sticky-note { position: absolute; z-index: 6; right: -1px; bottom: 34px; width: 208px; padding: 14px 13px 16px; border: 2px solid var(--ink); background-color: var(--acid); background-image: linear-gradient(90deg, transparent 89%, rgba(48,71,216,.18) 89%), linear-gradient(transparent 89%, rgba(48,71,216,.18) 89%); background-size: 14px 14px; box-shadow: 5px 5px 0 var(--ink); transform: rotate(-5deg); }.sticky-note small { display: block; margin-bottom: 10px; font: 400 9px var(--mono); }.sticky-note strong { font: 700 16px/.98 var(--font); letter-spacing: -.045em; }.terminal { position: absolute; z-index: 5; right: 8px; top: 184px; width: 172px; overflow: hidden; padding: 0 10px 10px; border: 2px solid var(--ink); background: var(--ink); color: var(--paper); box-shadow: 4px 4px 0 var(--coral); transform: rotate(-1deg); font-family: var(--mono); }.terminal-top { height: 25px; display: flex; align-items: center; gap: 4px; margin: 0 -10px 9px; padding: 0 8px; border-bottom: 1px solid #4a4a42; background: #282823; }.terminal-top i { width: 5px; height: 5px; border-radius: 50%; background: var(--coral); }.terminal-top i:nth-child(2) { background: var(--acid); }.terminal-top i:nth-child(3) { background: var(--tape-blue); }.terminal-top b { margin-left: auto; font-size: 8px; font-weight: 400; color: #cfcbbd; }.terminal p, .terminal strong, .terminal small { display: block; margin: 0; }.terminal p { font-size: 8px; }.terminal strong { margin: 5px 0; color: var(--acid); font-size: 10px; font-weight: 500; }.terminal small { color: var(--tape-blue); font-size: 7px; }.terminal-caret { animation: blink 1s steps(1) infinite; }
  .decoration { position: absolute; z-index: 2; }.flower { top: 10px; left: 0; width: 46px; height: 46px; transform: rotate(-15deg); }.flower i { position: absolute; width: 20px; height: 20px; border: 2px solid var(--ink); border-radius: 50%; background: var(--coral); }.flower i:nth-child(1) { left: 13px; top: 0; }.flower i:nth-child(2) { right: 0; top: 13px; }.flower i:nth-child(3) { left: 13px; bottom: 0; }.flower i:nth-child(4) { left: 0; top: 13px; }.flower b { position: absolute; inset: 14px; z-index: 1; border: 2px solid var(--ink); border-radius: 50%; background: var(--acid); }.sparkle { top: 5px; right: 25px; color: var(--ink); font-size: 42px; transform: rotate(15deg); }.pixel-cursor { z-index: 4; left: -3px; top: 193px; width: 51px; height: 68px; background: var(--acid); clip-path: polygon(0 0, 0 100%, 25% 74%, 39% 100%, 54% 91%, 40% 66%, 70% 66%); filter: drop-shadow(4px 4px 0 var(--ink)); }.code-sticker { right: 172px; bottom: 43px; display: grid; place-items: center; width: 87px; height: 56px; border: 2px solid var(--ink); border-radius: 50%; background: var(--coral); box-shadow: 4px 4px 0 var(--ink); transform: rotate(10deg); }.code-sticker b { font: 500 22px var(--mono); }.code-sticker i { color: var(--paper); font-style: normal; }.smiley { z-index: 4; top: 83px; right: -7px; width: 81px; height: 81px; border: 2px solid var(--ink); border-radius: 50%; background: var(--pink); box-shadow: 4px 4px 0 var(--ink); transform: rotate(-8deg); }.smiley i { position: absolute; top: 26px; width: 7px; height: 9px; background: var(--ink); }.smiley i:first-child { left: 24px; }.smiley i:nth-child(2) { right: 24px; }.smiley b { position: absolute; left: 28px; top: 45px; width: 21px; height: 10px; border: 2px solid var(--ink); border-top: 0; border-radius: 0 0 20px 20px; }.direction { right: 18px; bottom: 3px; color: var(--coral); font: 700 64px/.6 var(--font); transform: rotate(24deg); }
  .ticker { position: relative; z-index: 7; width: calc(100% + 30px); margin-left: -15px; overflow: hidden; padding: 11px 0; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); background: var(--blue); color: var(--paper); font: 500 11px var(--mono); letter-spacing: .08em; white-space: nowrap; transform: rotate(-.5deg); }.ticker div { width: max-content; padding-left: 15px; }.ticker i { color: var(--acid); font-style: normal; padding: 0 8px; }@keyframes status-pulse { 50% { opacity: .45; } } @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 960px) { .hero { gap: 32px; }.portrait-card { left: 0; width: 305px; }.portrait-frame { height: 320px; }.pixel-person { transform: scale(.9); transform-origin: bottom; }.terminal { right: 0; }.sticky-note { right: -8px; } }
  @media (max-width: 760px) { .header-inner, .portfolio-main { width: min(100% - 36px, 580px); }.header-inner { grid-template-columns: 1fr auto; }.header-inner nav { display: none; }.hero { display: block; min-height: 0; padding: 42px 0 20px; }.artwork { width: min(100%, 490px); height: 530px; margin: 53px auto 0; }.portrait-card { left: calc(50% - 165px); }.sticky-note { right: 0; }.terminal { right: 0; }.ticker { margin-top: 8px; } }
  @media (max-width: 420px) { h1 { font-size: clamp(45px, 15.2vw, 62px); } h1 .outline { -webkit-text-stroke-width: 2px; }.intro { font-size: 12px; }.actions { gap: 19px; }.artwork { height: 490px; }.portrait-card { left: calc(50% - 137px); width: 275px; padding: 11px; }.portrait-frame { height: 289px; }.pixel-person { transform: scale(.78); }.portrait-caption { font-size: 10px; }.sticky-note { width: 158px; padding: 10px; bottom: 28px; }.sticky-note strong { font-size: 12px; }.terminal { top: 164px; width: 154px; }.code-sticker { right: 140px; bottom: 18px; transform: scale(.75) rotate(10deg); }.smiley { top: 56px; transform: scale(.78) rotate(-8deg); transform-origin: top right; }.pixel-cursor { left: 0; top: 178px; transform: scale(.8); }.stack { font-size: 7px; gap: 6px; }.direction { right: 5px; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }
</style>
