---
import Base from '../layouts/Base.astro';
import { site, skillGroups, languages } from '../data/site';
---
<Base title="About">
  <h1>About</h1>
  <p>
    I'm a software engineer based in {site.location}. I'm finishing an MSc in Computer Science &amp;
    Artificial Intelligence at Sapienza, and my thesis work at the Camera dei Deputati is about using
    retrieval-augmented generation and local LLMs to understand large legacy codebases.
  </p>
  <p>
    Before that I built full-stack and real-time interfaces with Java/Spring Boot, React and Angular,
    shipped on Docker and Kubernetes, in Tirana and Rome.
  </p>
  <h2>Skills</h2>
  {skillGroups.map((g) => (
    <p><strong>{g.label}:</strong> {g.items.map((s) => <span class="tag">{s}</span>)}</p>
  ))}
  <p class="muted">{languages}</p>
  <h2>Contact</h2>
  <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
</Base>
