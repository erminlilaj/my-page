---
import Base from '../layouts/Base.astro';
import { experience, education, skillGroups, languages } from '../data/site';
---
<Base title="Resume">
  <h1>Resume</h1>
  <h2>Experience</h2>
  {experience.map((e) => (
    <div class="card" style="margin-bottom:1rem">
      <h3>{e.role}</h3>
      <div class="muted">{e.org} · {e.period}</div>
      {e.summary && <p>{e.summary}</p>}
    </div>
  ))}
  <h2>Education</h2>
  {education.map((e) => (
    <div class="card" style="margin-bottom:1rem">
      <h3>{e.degree}</h3>
      <div class="muted">{e.org} · {e.period}</div>
    </div>
  ))}
  <h2>Skills</h2>
  {skillGroups.map((g) => (
    <p><strong>{g.label}:</strong> {g.items.map((s) => <span class="tag">{s}</span>)}</p>
  ))}
  <p class="muted">{languages}</p>
</Base>
