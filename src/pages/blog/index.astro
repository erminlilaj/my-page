---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Blog">
  <h1>Blog</h1>
  {posts.map((p) => (
    <article class="card" style="margin-bottom:1rem">
      <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
      <div class="muted">{p.data.date.toLocaleDateString('en', { dateStyle: 'long' })}</div>
      {p.data.description && <p>{p.data.description}</p>}
    </article>
  ))}
</Base>
