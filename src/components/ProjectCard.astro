---
interface Props { title: string; description: string; tags: string[]; href: string }
const { title, description, tags, href } = Astro.props;
---
<a class="card" href={href}>
  <h3>{title}</h3>
  <p class="muted">{description}</p>
  {tags.map((t) => <span class="tag">{t}</span>)}
</a>
<style>
  a { display: block; color: inherit; text-decoration: none; transition: border-color .15s; }
  a:hover { border-color: var(--accent); }
</style>
