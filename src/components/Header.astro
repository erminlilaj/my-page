---
const nav = [
  { label: 'About', href: '/#about', prefix: '01/' },
  { label: 'Work', href: '/#work', prefix: '02/' },
  { label: 'Experience', href: '/#experience', prefix: '03/' },
  { label: 'Journey', href: '/#journey', prefix: '04/' },
  { label: 'Links', href: '/#contact', prefix: '05/' },
];
---
<header class="site-header">
  <div class="header-inner">
    <a class="monogram" href="/" aria-label="Ermin Lilaj, home"><span class="badge" aria-hidden="true"><svg viewBox="0 0 8 8" width="48" height="48" shape-rendering="crispEdges"><g class="shadow"><rect x="7" y="2" width="1" height="6"/><rect x="1" y="7" width="6" height="1"/></g><g class="tile"><rect x="0" y="0" width="6" height="1"/><rect x="0" y="6" width="7" height="1"/><rect x="0" y="1" width="1" height="5"/><rect x="3" y="1" width="1" height="5"/><rect x="2" y="2" width="1" height="1"/><rect x="2" y="4" width="1" height="1"/><rect x="6" y="1" width="1" height="5"/><rect x="5" y="2" width="1" height="3"/></g><rect class="fold" x="5" y="1" width="1" height="1"/></svg></span><span class="wordmark" translate="no"><strong>Ermin Lilaj</strong><small>Software engineer</small></span></a>
    <nav aria-label="Primary navigation">
      {nav.map((n) => (
        <a href={n.href}><small>{n.prefix}</small> {n.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Switch to dark mode"><span aria-hidden="true">◐</span></button>
    </div>
  </div>
</header>
<style>
  .site-header { position: relative; z-index: 10; border-bottom: 2px solid var(--ink); background: var(--paper); }
  .header-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; width: min(1180px, calc(100% - 64px)); min-height: 77px; margin: 0 auto; padding: 18px 0; }
  .badge { display: block; width: 48px; height: 48px; flex: none; }
  .badge svg { display: block; width: 48px; height: 48px; }
  .badge .shadow { fill: #0f3d91; }
  .badge .tile { fill: var(--ink); }
  .badge .fold { fill: var(--coral); }
  :global(:root[data-theme='dark']) .badge .shadow { fill: #122a55; }
  .wordmark { display: grid; gap: 3px; line-height: 1; }
  .wordmark strong { font: 700 17px/1 var(--font); letter-spacing: -.03em; }
  .wordmark small { color: var(--ink); opacity: .65; font: 400 10px/1 var(--mono); letter-spacing: .02em; }
  .monogram { display: inline-flex; align-items: center; gap: 12px; justify-self: start; color: var(--ink); text-decoration: none; }
  nav { display: flex; gap: 22px; }
  nav a { position: relative; padding: 4px 0; color: var(--ink); font: 500 12px var(--mono); text-decoration: none; text-transform: uppercase; }
  nav a small { color: var(--blue); font-size: 9px; vertical-align: 1px; }
  nav a::after { position: absolute; right: 0; bottom: -2px; left: 0; height: 3px; background: var(--coral); content: ''; transform: scaleX(0) rotate(-1deg); transform-origin: left; transition: transform .2s ease; }
  nav a:hover::after, nav a:focus-visible::after, nav a[aria-current]::after { transform: scaleX(1) rotate(-1deg); }
  .header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 14px; }
  .theme-toggle { width: 36px; height: 36px; padding: 0; border: 2px solid var(--ink); background: transparent; color: var(--ink); font-size: 18px; line-height: 1; cursor: pointer; }
  .theme-toggle:hover, .theme-toggle:focus-visible { background: var(--acid); }
  .talk-button { justify-self: end; padding: 10px 12px 9px; border: 2px solid var(--ink); background: var(--acid); box-shadow: 3px 3px 0 var(--shadow, var(--ink)); color: var(--ink); font: 500 11px var(--mono); text-decoration: none; text-transform: uppercase; transition: transform .15s ease, box-shadow .15s ease; }
  .talk-button:hover, .talk-button:focus-visible { box-shadow: none; transform: translate(3px, 3px); }
  @media (max-width: 480px) { .wordmark small { display: none; } }
  @media (max-width: 760px) { .header-inner { grid-template-columns: 1fr auto; width: min(100% - 36px, 580px); } nav { display: none; } }
</style>
<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const sync = () => {
    const isDark = root.dataset.theme === 'dark';
    toggle?.setAttribute('aria-pressed', String(isDark));
    toggle?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
  };
  sync();
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });
</script>
